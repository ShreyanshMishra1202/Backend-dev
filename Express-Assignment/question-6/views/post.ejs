<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <% if (!post) { %>
    <h1>Post Not Found</h1>
    <p><a href="/posts">Back to posts</a></p>
  <% } else { %>
    <h1><%= post.title %></h1>
    <p><%= post.body %></p>
    <p><a href="/posts">Back to posts</a></p>
  <% } %>
</body>
</html>
