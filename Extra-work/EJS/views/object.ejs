<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% if (items && items.length > 0) { %>
        <ul>
            <% items.forEach(item => { %>
                <li><%= item.name %> - $<%= item.price %></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No items available.</p>
    <% } %>
</body>
</html>